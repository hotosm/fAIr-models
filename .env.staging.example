# AWS staging cluster env vars for running examples locally.
# Copy to .env.staging, fill in secrets, then: source .env.staging

# ZenML (external, API key auth)
export ZENML_STORE_URL=https://zenml.ai.hotosm.org
export ZENML_STORE_API_KEY="<your-zenml-api-key>"

# STAC API (external)
export FAIR_STAC_API_URL="https://stac.ai.hotosm.org/stac"

# Postgres (via port-forward: kubectl port-forward svc/fair-stac-db-rw -n postgres 5433:5432)
export FAIR_DSN="postgresql://<user>:<password>@localhost:5433/fair-stac?sslmode=require"

# AWS S3 (real AWS, not MinIO)
# Do NOT set FAIR_S3_PUBLIC_URL for real AWS S3; the code auto-builds
# virtual-hosted URLs from the bucket name + AWS_REGION.
export AWS_ACCESS_KEY_ID="<your-aws-access-key>"
export AWS_SECRET_ACCESS_KEY="<your-aws-secret-key>"
export AWS_REGION="us-east-1"
export FAIR_S3_UPLOAD_ACL="public-read"
export AWS_REQUEST_CHECKSUM_CALCULATION="when_required"
export AWS_RESPONSE_CHECKSUM_VALIDATION="when_required"

# MLflow (in-cluster only, port-forwarded for stack registration)
export MLFLOW_ADMIN_USER="<mlflow-user>"
export MLFLOW_ADMIN_PASSWORD="<mlflow-password>"

# fAIr
export FAIR_KNATIVE_NAMESPACE="knative-serving"
export FAIR_LABEL_DOMAIN="fair-k8s"
export FAIR_PREDICT_DOMAIN="ai.hotosm.org"
export FAIR_UPLOAD_ARTIFACTS=true
export FAIR_USER_ID="<your-user-id>"
