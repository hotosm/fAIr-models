apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: stac
  namespace: fair
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
    nginx.ingress.kubernetes.io/use-regex: "true"
    nginx.ingress.kubernetes.io/rewrite-target: /$2
spec:
  ingressClassName: nginx
  tls:
    - secretName: stac-tls
      hosts:
        - stac.${FAIR_DOMAIN}
  rules:
    - host: stac.${FAIR_DOMAIN}
      http:
        paths:
          - path: /(/|$)(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: stac-stac
                port: { number: 8080 }
          - path: /stac(/|$)(.*)
            pathType: ImplementationSpecific
            backend:
              service:
                name: stac-stac
                port: { number: 8080 }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: mlflow
  namespace: fair
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt
spec:
  ingressClassName: nginx
  tls:
    - secretName: mlflow-tls
      hosts:
        - mlflow.${FAIR_DOMAIN}
  rules:
    - host: mlflow.${FAIR_DOMAIN}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: mlflow
                port: { number: 80 }
---
apiVersion: networking.k8s.io/v1
