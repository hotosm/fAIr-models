{
    "type": "Feature",
    "stac_version": "1.1.0",
    "stac_extensions": [
        "https://stac-extensions.github.io/mlm/v1.5.1/schema.json",
        "https://stac-extensions.github.io/version/v1.2.0/schema.json",
        "https://stac-extensions.github.io/classification/v2.0.0/schema.json",
        "https://stac-extensions.github.io/file/v2.1.0/schema.json",
        "https://stac-extensions.github.io/raster/v1.1.0/schema.json",
        "https://hotosm.github.io/fAIr-models/schemas/v1.0.0/base-model/schema.json"
    ],
    "id": "dinov3-buildings",
    "geometry": {
        "type": "Polygon",
        "coordinates": [[[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]]]
    },
    "bbox": [-180, -90, 180, 90],
    "properties": {
        "datetime": "2026-05-21T00:00:00Z",
        "created": "2026-05-18T00:00:00Z",
        "updated": "2026-05-21T00:00:00Z",
        "title": "DINOv3-L + UperNet Building Segmentation",
        "description": "Frozen DINOv3-ViT-L/16 (LVD1689M) encoder with a UperNet decoder, multi-task auxiliary heads (boundary + signed distance), and watershed instance separation, for binary building segmentation from very high resolution RGB aerial imagery. Decoder pretrained on hotosm/vhr-building-segmentation (~58k chips, OAM + OSM, global). Intended for direct inference or decoder fine-tuning on small downstream OAM + OSM labelled sets (~100-200 chips).",
        "mlm:name": "dinov3-buildings",
        "mlm:architecture": "ViT-L/16 + UperNet",
        "mlm:tasks": ["semantic-segmentation"],
        "mlm:framework": "PyTorch",
        "mlm:framework_version": "2.7.1",
        "mlm:pretrained": true,
        "mlm:pretrained_source": "https://arxiv.org/abs/2508.10104",
        "mlm:accelerator": "amd64",
        "mlm:accelerator_count": 1,
        "keywords": ["building", "semantic-segmentation", "polygon"],
        "license": "Apache-2.0",
        "version": "1",
        "deprecated": false,
        "providers": [
            {
                "name": "Kshitij Raj Sharma",
                "roles": ["processor"],
                "url": "https://github.com/kshitijrajsharma/dinov3-hot-ablation",
                "description": "Author of the dinov3-hot-ablation model recipe (decoder, multi-task training, watershed + DP+MBR-safe vectorisation)."
            },
            {
                "name": "Facebook Research",
                "roles": ["licensor"],
                "url": "https://arxiv.org/abs/2508.10104",
                "description": "DINOv3-ViT-L/16 encoder, used frozen."
            },
            {
                "name": "HOTOSM",
                "roles": ["producer", "host"],
                "url": "https://www.hotosm.org",
                "description": "Humanitarian OpenStreetMap Team"
            }
        ],
        "fair:metrics_spec": [
            {"key": "fair:pixel_iou", "name": "Pixel IoU", "description": "Building-class pixel IoU on the val split: sum of intersection pixels divided by sum of union pixels across all val chips."},
            {"key": "fair:instance_precision", "name": "Instance Precision @ IoU>0.5", "description": "Fraction of predicted building instances that match a ground-truth instance at IoU>0.5 (panoptic-style matching via torchmetrics)."},
            {"key": "fair:instance_recall", "name": "Instance Recall @ IoU>0.5", "description": "Fraction of ground-truth building instances matched by a prediction at IoU>0.5."},
            {"key": "fair:instance_f1", "name": "Instance F1 @ IoU>0.5", "description": "Harmonic mean of instance precision and recall, micro-averaged across the val split."},
            {"key": "fair:pred_avg_vertices", "name": "Predicted polygon avg vertices", "description": "Mean exterior vertex count across all predicted polygons after DP+MBR-safe regularisation, measured in each polygon's local UTM zone."},
            {"key": "fair:pred_orthogonality", "name": "Predicted polygon orthogonality", "description": "Mean per-polygon fraction of edges within 5 degrees of the minimum-rotated-rectangle dominant axis. 1.0 = perfectly rectangular, near 0 = jagged/free-form."}
        ],
        "mlm:input": [
            {
                "name": "RGB chips",
                "bands": [{"name": "red"}, {"name": "green"}, {"name": "blue"}],
                "input": {
                    "shape": [-1, 3, 256, 256],
                    "dim_order": ["batch", "bands", "height", "width"],
                    "data_type": "float32"
                },
                "pre_processing_function": {
                    "format": "python",
                    "expression": "models.dinov3_buildings.pipeline:preprocess"
                }
            }
        ],
        "mlm:output": [
            {
                "name": "segmentation logits",
                "tasks": ["semantic-segmentation"],
                "result": {
                    "shape": [-1, 3, 256, 256],
                    "dim_order": ["batch", "channel", "height", "width"],
                    "data_type": "float32"
                },
                "classification:classes": [
                    {"name": "background", "value": 0, "description": "Non-building pixels"},
                    {"name": "building", "value": 1, "description": "Building footprints"}
                ],
                "post_processing_function": {
                    "format": "python",
                    "expression": "models.dinov3_buildings.pipeline:postprocess"
                },
                "bands": []
            }
        ],
        "mlm:hyperparameters": {
            "training.epochs": 15,
            "training.batch_size": 8,
            "training.learning_rate": 5e-5,
            "training.weight_decay": 0.01,
            "training.val_ratio": 0.2,
            "training.split_seed": 42,
            "training.block_size": 4,
            "training.inner_val_frac": 0.1,
            "training.freeze_encoder": true,
            "training.norm_stats": "hot_global",
            "inference.confidence_threshold": 0.5,
            "inference.simplify_m": 1.0,
            "inference.regularize_area_threshold": 0.55,
            "inference.regularize_overlap_tol_m2": 1.0,
            "inference.min_area_m2": 1.0
        },
        "fair:split_spec": {
            "strategy": "spatial",
            "default_ratio": 0.2,
            "seed": 42,
            "block_size": 4,
            "description": "Spatial block split on OAM-x-y-z tile coords: chips grouped into (x // block_size, y // block_size) blocks, whole blocks assigned to train or val. Non-OAM filenames fall back to a seeded random split."
        },
        "fair:hyperparameters_spec": [
            {"key": "epochs", "type": "int", "default": 15, "min": 1, "max": 500, "description": "Decoder fine-tuning epochs"},
            {"key": "batch_size", "type": "int", "default": 8, "min": 1, "max": 64, "description": "Training batch size"},
            {"key": "learning_rate", "type": "float", "default": 5e-5, "min": 1e-7, "max": 1.0, "description": "AdamW learning rate (decoder only; encoder is frozen)"},
            {"key": "weight_decay", "type": "float", "default": 0.01, "min": 0.0, "max": 1.0, "description": "AdamW weight decay"},
            {"key": "val_ratio", "type": "float", "default": 0.2, "min": 0.05, "max": 0.5, "description": "Fraction of chips held out as spatial val. Blocks are added to val until this share of total chips is reached."},
            {"key": "split_seed", "type": "int", "default": 42, "min": 0, "max": 2147483647, "description": "Seed for block ordering in the spatial split"},
            {"key": "block_size", "type": "int", "default": 4, "min": 1, "max": 32, "description": "Side length (in TMS tile units) of the spatial block that holds adjacent chips together; larger blocks = stronger spatial separation, fewer blocks to split."},
            {"key": "inner_val_frac", "type": "float", "default": 0.1, "min": 0.05, "max": 0.5, "description": "Within-train holdout that upstream finetune uses for Lightning's per-epoch val_loss/val_iou and early stopping. Independent of the catalog-facing spatial val."},
            {"key": "freeze_encoder", "type": "bool", "default": true, "description": "Keep the DINOv3 encoder frozen (recommended)"},
            {"key": "norm_stats", "type": "str", "default": "hot_global", "values": ["hot_global", "dataset"], "description": "Input normalisation source. 'hot_global' uses mean/std from the hotosm/vhr-building-segmentation dataset (matches pretraining). 'dataset' computes per-channel mean/std from the user's finetune chips, pick this when your imagery differs substantially from HOT global imagery."},
            {"key": "confidence_threshold", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0, "description": "Sigmoid threshold for building mask"},
            {"key": "simplify_m", "type": "float", "default": 1.0, "min": 0.0, "max": 10.0, "description": "Douglas-Peucker tolerance in metres (EPSG:3857). 0 disables simplification."},
            {"key": "regularize_area_threshold", "type": "float", "default": 0.55, "min": 0.0, "max": 1.0, "description": "Minimum polygon-area / MBR-area ratio for the rectangle-substitution step. Lower = more aggressive squaring of corners."},
            {"key": "regularize_overlap_tol_m2", "type": "float", "default": 1.0, "min": 0.0, "max": 100.0, "description": "Maximum new neighbour overlap (m^2) allowed when substituting a polygon with its MBR. Keeps adjacent buildings from being merged."},
            {"key": "min_area_m2", "type": "float", "default": 1.0, "min": 0.0, "max": 1000.0, "description": "Drop polygons smaller than this area (m^2). Filters specks from sub-pixel artefacts."}
        ]
    },
    "assets": {
        "checkpoint": {
            "href": "https://huggingface.co/kshitijrajsharma/dinov3-hot-buildings/resolve/main/dinov3l_upernet_hot.ckpt",
