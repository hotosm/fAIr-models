{
  "type": "Feature",
  "stac_version": "1.1.0",
  "stac_extensions": [
    "https://stac-extensions.github.io/mlm/v1.5.1/schema.json",
    "https://stac-extensions.github.io/version/v1.2.0/schema.json",
    "https://stac-extensions.github.io/classification/v2.0.0/schema.json",
    "https://stac-extensions.github.io/file/v2.1.0/schema.json",
    "https://stac-extensions.github.io/raster/v1.1.0/schema.json",
    "https://hotosm.github.io/fAIr-models/schemas/v1.0.0/base-model/schema.json"
  ],
  "id": "segformer-parking-lot",
  "geometry": {
    "type": "Polygon",
    "coordinates": [[[-180, -90], [180, -90], [180, 90], [-180, 90], [-180, -90]]]
  },
  "bbox": [-180, -90, 180, 90],
  "properties": {
    "datetime": "2026-09-21T00:00:00Z",
    "created": "2026-09-21T00:00:00Z",
    "updated": "2026-09-21T00:00:00Z",
    "title": "SegFormer Parking Lot",
    "description": "SegFormer MiT-B5 semantic segmentation model for parking-lot extraction from RGB OAM chips. Inference returns EPSG:4326 GeoJSON polygons.",
    "mlm:name": "segformer-parking-lot",
    "mlm:architecture": "SegFormer MiT-B5",
    "mlm:tasks": ["semantic-segmentation"],
    "mlm:framework": "PyTorch",
    "mlm:framework_version": "2.10.0",
    "mlm:pretrained": true,
    "mlm:pretrained_source": "https://huggingface.co/UTEL-UIUC/SegFormer-large-parking",
    "mlm:accelerator": "cuda",
    "mlm:accelerator_count": 1,
    "fair:pinned": false,
    "fair:recommended_zoom": 18,
    "keywords": ["parking_lot", "semantic-segmentation", "polygon"],
    "license": "Apache-2.0",
    "version": "1",
    "deprecated": false,
    "providers": [
      {
        "name": "HOTOSM",
        "roles": ["producer", "host"],
        "url": "https://www.hotosm.org",
        "description": "Humanitarian OpenStreetMap Team"
      }
    ],
    "fair:metrics_spec": [
      {
        "key": "fair:accuracy",
        "name": "Pixel Accuracy",
        "description": "Dataset-level micro pixel accuracy on validation masks."
      },
      {
        "key": "fair:mean_iou",
        "name": "Mean IoU",
        "description": "Dataset-level mean IoU across background and parking_lot classes."
      },
      {
        "key": "fair:iou_background",
        "name": "IoU Background",
        "description": "Intersection-over-Union for the background class."
      },
      {
        "key": "fair:iou_parking_lot",
        "name": "IoU Parking Lot",
        "description": "Intersection-over-Union for the parking_lot class."
      }
    ],
    "mlm:input": [
      {
        "name": "RGB chips",
        "bands": [{ "name": "red" }, { "name": "green" }, { "name": "blue" }],
        "input": {
          "shape": [-1, 3, 512, 512],
          "dim_order": ["batch", "bands", "height", "width"],
          "data_type": "float32"
        },
        "pre_processing_function": {
          "format": "python",
          "expression": "models.segformer_parking_lot.pipeline:preprocess"
        }
      }
    ],
    "mlm:output": [
      {
        "name": "segmentation logits",
        "tasks": ["semantic-segmentation"],
        "result": {
          "shape": [-1, 2, 128, 128],
          "dim_order": ["batch", "channel", "height", "width"],
          "data_type": "float32"
        },
        "classification:classes": [
          { "name": "background", "value": 0, "description": "Non-parking pixels" },
          { "name": "parking_lot", "value": 1, "description": "Parking-lot pixels" }
        ],
        "post_processing_function": {
          "format": "python",
          "expression": "models.segformer_parking_lot.pipeline:postprocess"
        },
        "bands": []
      }
    ],
    "mlm:hyperparameters": {
      "training.epochs": 20,
      "training.batch_size": 4,
      "training.learning_rate": 1e-5,
      "training.weight_decay": 0.0,
      "training.pos_weight": 4.76,
      "training.early_stop_patience": 10,
      "training.freeze_encoder": true,
      "training.sample_fraction": 1.0,
      "training.chip_size": 512,
      "training.imagenet_norm": true,
      "training.normalize_01": true,
      "training.val_ratio": 0.1,
      "training.split_seed": 42,
      "training.block_size": 4,
      "inference.confidence_threshold": 0.5,
      "inference.model_input_size": 512,
      "inference.imagenet_norm": true,
      "inference.normalize_01": true,
      "inference.min_area_m2": 60.0,
      "inference.hole_area_m2": 60.0,
      "inference.simplify_m": 1.0
    },
    "fair:split_spec": {
      "strategy": "spatial",
      "default_ratio": 0.1,
      "seed": 42,
      "block_size": 4,
      "description": "Spatial block split on OAM tile coords. Chips are grouped by (x // block_size, y // block_size) and whole blocks are assigned to train or validation."
    },
    "fair:hyperparameters_spec": [
      { "key": "epochs", "type": "int", "default": 20, "min": 1, "max": 500, "description": "Training epochs" },
      { "key": "batch_size", "type": "int", "default": 4, "min": 1, "max": 64, "description": "Training batch size" },
      { "key": "learning_rate", "type": "float", "default": 1e-5, "min": 1e-7, "max": 1.0, "description": "Adam learning rate" },
      { "key": "weight_decay", "type": "float", "default": 0.0, "min": 0.0, "max": 1.0, "description": "Adam weight decay" },
      { "key": "pos_weight", "type": "float", "default": 4.76, "min": 0.1, "max": 20.0, "description": "Foreground positive class weight in BCEWithLogitsLoss" },
      { "key": "early_stop_patience", "type": "int", "default": 10, "min": 1, "max": 100, "description": "Epochs without validation-loss improvement before stopping" },
      { "key": "freeze_encoder", "type": "bool", "default": true, "description": "Freeze the SegFormer encoder and train the decode head only" },
      { "key": "sample_fraction", "type": "float", "default": 1.0, "min": 0.001, "max": 1.0, "description": "Fraction of training chips used" },
      { "key": "val_ratio", "type": "float", "default": 0.1, "min": 0.05, "max": 0.5, "description": "Validation split target ratio" },
      { "key": "split_seed", "type": "int", "default": 42, "min": 0, "max": 2147483647, "description": "Spatial split RNG seed" },
      { "key": "block_size", "type": "int", "default": 4, "min": 1, "max": 32, "description": "Spatial block size in OAM tile units" },
      { "key": "chip_size", "type": "int", "default": 512, "min": 256, "max": 1024, "description": "Training input side length" },
      { "key": "model_input_size", "type": "int", "default": 512, "min": 256, "max": 1024, "description": "Inference input side length; must match the exported ONNX graph" },
      { "key": "normalize_01", "type": "bool", "default": true, "description": "Scale RGB uint8 values to [0,1] before normalization" },
      { "key": "imagenet_norm", "type": "bool", "default": true, "description": "Apply ImageNet mean and standard deviation after scaling to [0,1]" },
      { "key": "confidence_threshold", "type": "float", "default": 0.5, "min": 0.0, "max": 1.0, "description": "Parking probability threshold" },
      { "key": "min_area_m2", "type": "float", "default": 60.0, "min": 0.0, "max": 10000.0, "description": "Drop polygons smaller than this area in square meters" },
      { "key": "hole_area_m2", "type": "float", "default": 60.0, "min": 0.0, "max": 10000.0, "description": "Fill interior holes below this area in square meters" },
      { "key": "simplify_m", "type": "float", "default": 1.0, "min": 0.0, "max": 20.0, "description": "Douglas-Peucker simplification tolerance in source CRS units" }
    ]
  },
