          "expression": "models.unet_roads.pipeline:postprocess"
        }
      },
      {
        "name": "roads",
        "description": "Road surface polygons vectorised from the thresholded road mask, one row per feature.",
        "tasks": [
          "semantic-segmentation"
        ],
        "result": {
          "shape": [
