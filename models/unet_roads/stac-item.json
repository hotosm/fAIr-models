        ],
        "url": "https://www.hotosm.org",
        "description": "Humanitarian OpenStreetMap Team"
      }
    ],
    "fair:metrics_spec": [
      {
        "key": "iou_road",
        "name": "Road IoU",
        "description": "Intersection over union of predicted and labelled road pixels on the held-out chips."
      },
      {
        "key": "relaxed_precision",
        "name": "Relaxed precision",
        "description": "Share of the predicted road mask's centreline within the relaxed tolerance of the labelled mask's centreline."
      },
      {
        "key": "relaxed_recall",
        "name": "Relaxed recall",
        "description": "Share of the labelled road mask's centreline within the relaxed tolerance of the predicted mask's centreline."
      },
      {
        "key": "relaxed_f1",
        "name": "Relaxed F1",
        "description": "Harmonic mean of relaxed precision and relaxed recall."
      }
    ],
    "fair:split_spec": {
      "strategy": "spatial",
      "default_ratio": 0.2,
      "seed": 42,
      "description": "Blocks of neighbouring OpenAerialMap tiles are held out together so a road never runs across train and validation; small datasets fall back to holding out single chips."
    },
    "fair:hyperparameters_spec": [
      {
        "key": "val_ratio",
        "name": "Validation ratio",
        "description": "Fraction of chips held out for validation.",
        "type": "float",
        "default": 0.2,
        "min": 0.1,
        "max": 0.5
      },
      {
        "key": "split_seed",
        "name": "Split seed",
        "description": "Random seed for the train and validation split.",
        "type": "int",
        "default": 42,
        "min": 0,
        "max": 100000
      },
      {
        "key": "block_size",
        "name": "Split block size",
        "description": "Side length, in tiles, of the spatial blocks held out together.",
        "type": "int",
        "default": 4,
        "min": 1,
        "max": 32
      },
      {
        "key": "epochs",
        "name": "Epochs",
        "description": "Passes over the training chips.",
        "type": "int",
        "default": 20,
        "min": 1,
        "max": 300
      },
      {
        "key": "batch_size",
        "name": "Batch size",
        "description": "Chips per optimisation step.",
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 64
      },
      {
        "key": "learning_rate",
        "name": "Learning rate",
        "description": "AdamW learning rate.",
        "type": "float",
        "default": 5e-05,
        "min": 1e-06,
        "max": 0.01
      },
      {
        "key": "road_width_m",
        "name": "Road width (m)",
        "description": "Width that line or point labels are buffered to before they are burned into training masks; polygon labels are burned as drawn.",
        "type": "float",
        "default": 6.0,
        "min": 1.0,
        "max": 30.0
      },
      {
        "key": "relaxed_tolerance_px",
        "name": "Relaxed tolerance (px)",
        "description": "Distance, in model pixels, within which the centrelines of the predicted and labelled road masks count as matching.",
        "type": "int",
        "default": 3,
        "min": 0,
        "max": 20
      },
      {
        "key": "confidence_threshold",
        "name": "Confidence threshold",
        "description": "Minimum road probability for a pixel to be part of a road polygon.",
        "type": "float",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      },
      {
        "key": "min_area_m2",
        "name": "Minimum area (m2)",
        "description": "Road polygons smaller than this are dropped as noise.",
        "type": "float",
        "default": 30.0,
        "min": 0.0,
        "max": 10000.0
      },
      {
        "key": "simplify_m",
        "name": "Simplification tolerance (m)",
        "description": "Douglas-Peucker tolerance applied to the road polygons.",
        "type": "float",
        "default": 0.5,
        "min": 0.0,
        "max": 10.0
      },
      {
        "key": "photometric_augment",
        "name": "Colour and zoom augmentation",
        "description": "Apply random brightness, contrast, saturation, gamma, channel shift, noise and zoom during training.",
        "type": "bool",
        "default": true
      }
    ],
