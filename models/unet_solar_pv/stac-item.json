  "bbox": [-180, -90, 180, 90],
  "properties": {
    "datetime": "2026-10-30T00:00:00Z",
    "created": "2026-10-30T00:00:00Z",
    "updated": "2026-11-02T00:00:00Z",
    "title": "Solar PV Panels",
    "description": "A U-Net with a ResNet-34 encoder that segments solar photovoltaic panels in RGB aerial imagery and returns them as polygons. Trained on the Jiang et al. (2021) PV dataset from Jiangsu, China, and finetunable in fAIr on panels labelled in a new area.",
    "mlm:name": "unet-solar-pv",
    "mlm:architecture": "U-Net",
    "mlm:tasks": ["semantic-segmentation"],
    "mlm:framework": "PyTorch",
    "mlm:framework_version": "2.11.0",
    "mlm:pretrained": true,
    "mlm:pretrained_source": "ImageNet",
    "mlm:accelerator": "amd64",
    "fair:recommended_zoom": 20,
    "fair:preview": {
      "center": [7.43293, 10.47003],
      "zoom": { "recommended": 20, "min": 19, "max": 20 },
      "imagery": {
        "url": "https://tiles.openaerialmap.org/6a063f1eaadd51d1db86b61f/0/6a063f1eaadd51d1db86b620/{z}/{x}/{y}",
        "type": "tms",
        "name": "OpenAerialMap - Kaduna",
        "attribution": "OpenAerialMap"
      },
      "place": { "name": "Kaduna", "country": "Nigeria", "country_code": "NG" }
    },
    "keywords": ["solar", "solar-panel", "photovoltaic", "energy", "semantic-segmentation", "polygon"],
    "license": "Apache-2.0",
    "version": "1",
    "deprecated": false,
    "providers": [
      {
        "name": "Oluwasola Oyinloye",
        "roles": ["producer", "licensor"],
        "url": "https://github.com/Dexsholex",
        "description": "Trained the U-Net on the Jiang et al. (2021) PV dataset and exported it to ONNX."
      },
      {
        "name": "HOTOSM",
        "roles": ["host"],
        "url": "https://www.hotosm.org",
        "description": "Humanitarian OpenStreetMap Team"
      }
    ],
    "fair:metrics_spec": [
      {
        "key": "iou_solar_panel",
        "name": "Solar panel IoU",
        "description": "Intersection over union of predicted and labelled solar panel pixels, summed over all validation chips, at the confidence threshold (default 0.5)."
      },
      {
        "key": "precision_solar_panel",
        "name": "Solar panel precision",
        "description": "Share of predicted solar panel pixels that are labelled panel, summed over all validation chips."
      },
      {
        "key": "recall_solar_panel",
        "name": "Solar panel recall",
        "description": "Share of labelled solar panel pixels that the model predicts, summed over all validation chips."
      },
      {
        "key": "f1_solar_panel",
        "name": "Solar panel F1",
        "description": "Harmonic mean of solar panel pixel precision and recall over all validation chips."
      }
    ],
    "fair:split_spec": {
      "strategy": "spatial",
      "default_ratio": 0.2,
      "seed": 42,
      "block_size": 4,
      "description": "Chips named OAM-<x>-<y>-<z>.tif are grouped into block_size x block_size tile blocks, and whole blocks go to train or validation, so the model is scored on areas it did not train on. Other chip names, or a dataset inside a single block, are held out chip by chip."
    },
    "fair:hyperparameters_spec": [
      {
        "key": "epochs",
        "name": "Epochs",
        "description": "Passes over the training chips.",
        "type": "int",
        "default": 15,
        "min": 1,
        "max": 200
      },
      {
        "key": "batch_size",
        "name": "Batch size",
        "description": "Chips per training step.",
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 64
      },
      {
        "key": "learning_rate",
        "name": "Learning rate",
        "description": "AdamW learning rate.",
        "type": "float",
        "default": 0.0001,
        "min": 0.000001,
        "max": 0.01
      },
      {
        "key": "scheduler",
        "name": "Learning rate schedule",
        "description": "Cosine decay of the learning rate to zero over training, or a constant rate.",
        "type": "str",
        "default": "cosine",
        "values": ["cosine", "none"]
      },
      {
        "key": "max_grad_norm",
        "name": "Gradient clipping",
        "description": "Maximum gradient norm per training step.",
        "type": "float",
        "default": 1.0,
        "min": 0.1,
        "max": 10.0
      },
      {
        "key": "freeze_encoder",
        "name": "Freeze encoder",
        "description": "Train only the U-Net decoder, which suits very small datasets.",
        "type": "bool",
        "default": false
      },
      {
        "key": "val_ratio",
        "name": "Validation ratio",
        "description": "Share of chips held out for validation.",
        "type": "float",
        "default": 0.2,
        "min": 0.05,
        "max": 0.5
      },
      {
        "key": "split_seed",
        "name": "Split seed",
        "description": "Random seed for the train and validation split and for training.",
        "type": "int",
        "default": 42,
        "min": 0,
        "max": 100000
      },
      {
        "key": "block_size",
        "name": "Split block size",
        "description": "Width in tiles of the square blocks the spatial split keeps together.",
        "type": "int",
        "default": 4,
        "min": 1,
        "max": 64
      },
      {
        "key": "confidence_threshold",
        "name": "Confidence threshold",
        "description": "Minimum solar panel probability for a pixel to be kept.",
        "type": "float",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0
      }
    ],
    "mlm:input": [
      {
        "name": "image",
        "bands": [{ "name": "red" }, { "name": "green" }, { "name": "blue" }],
        "input": {
          "shape": [-1, 3, 256, 256],
          "dim_order": ["batch", "bands", "height", "width"],
          "data_type": "float32"
        },
        "value_scaling": [
          { "type": "min-max", "minimum": 0, "maximum": 255 },
          { "type": "min-max", "minimum": 0, "maximum": 255 },
          { "type": "min-max", "minimum": 0, "maximum": 255 }
        ],
        "pre_processing_function": {
          "format": "python",
          "expression": "models.unet_solar_pv.pipeline:preprocess"
        }
      }
    ],
    "mlm:output": [
      {
        "name": "panel logits",
        "description": "One solar panel logit for every pixel; its sigmoid is the panel probability.",
        "tasks": ["semantic-segmentation"],
        "result": {
          "shape": [-1, 1, 256, 256],
          "dim_order": ["batch", "class", "height", "width"],
          "data_type": "float32"
        },
        "classification:classes": [
          { "name": "background", "value": 0, "description": "Pixels that are not solar panels" },
          { "name": "solar_panel", "value": 1, "description": "Solar PV panel pixels" }
        ],
        "post_processing_function": {
          "format": "python",
          "expression": "models.unet_solar_pv.pipeline:postprocess"
        }
      },
      {
        "name": "solar panels",
        "description": "Solar panel polygons traced from the thresholded pixel mask, one row per feature.",
        "tasks": ["semantic-segmentation"],
        "result": { "shape": [-1, 2], "dim_order": ["batch", "variables"], "data_type": "float32" },
        "variables": ["class", "label"],
        "classification:classes": [{ "name": "solar_panel", "value": 1, "description": "Solar PV panel pixels" }],
        "post_processing_function": {
          "format": "python",
          "expression": "models.unet_solar_pv.pipeline:postprocess"
        }
      }
    ],
    "cube:dimensions": {
      "features": {
        "type": "geometry",
        "bbox": [-180, -90, 180, 90],
        "geometry_types": ["Polygon"],
        "reference_system": 4326
      }
    },
    "cube:variables": {
      "label": {
        "dimensions": ["features"],
        "type": "data",
        "description": "Class name of the predicted class (solar_panel).",
        "values": ["solar_panel"]
      },
      "class": {
        "dimensions": ["features"],
        "type": "data",
        "description": "Predicted class value (1 = solar_panel).",
        "values": [1],
        "data_type": "uint8"
      }
    },
    "mlm:hyperparameters": {
      "training.epochs": 15,
      "training.batch_size": 8,
      "training.learning_rate": 0.0001,
      "training.scheduler": "cosine",
      "training.max_grad_norm": 1.0,
      "training.freeze_encoder": false,
      "training.val_ratio": 0.2,
      "training.split_seed": 42,
      "training.block_size": 4,
      "inference.confidence_threshold": 0.5
    }
  },
