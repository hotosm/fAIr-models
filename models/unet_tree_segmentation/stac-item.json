      "roles": ["mlm:inference-runtime"]
    },
    "batch-inference": {
      "href": "ghcr.io/hotosm/fair-models/unet_tree_segmentation:latest",
      "type": "application/vnd.oci.image.index.v1+json",
      "roles": ["mlm:inference-runtime"]
    },
    "readme": {
      "href": "https://raw.githubusercontent.com/hotosm/fAIr-models/refs/heads/develop/models/unet_tree_segmentation/README.md",
      "type": "text/markdown",
      "roles": ["metadata"]
    }
  }
}
