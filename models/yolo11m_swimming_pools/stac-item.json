    },
    "fair:split_spec": {
      "strategy": "spatial",
      "default_ratio": 0.2,
      "seed": 42,
      "block_size": 4,
      "description": "Spatial block split on OAM-x-y-z tile coords: chips grouped into (x // block_size, y // block_size) blocks, whole blocks assigned to train or val, because neighbouring chips share pools and surroundings. Chips must be named OAM-x-y-z.tif; any other name is rejected. Chips without a label are kept as background examples."
    },
    "fair:hyperparameters_spec": [
      {
        "key": "epochs",
        "type": "int",
        "default": 10,
        "min": 1,
        "max": 50,
        "description": "Number of training epochs. Mozilla trained the base model for 10; fine-tuning on a local dataset rarely needs more than a few dozen."
      },
      {
        "key": "batch_size",
        "type": "int",
        "default": 8,
        "min": 1,
        "max": 16,
        "description": "Chips per training batch, at 512 x 512 px on the one GPU of the training pod. 16 is Mozilla's value; lower it if the GPU runs out of memory."
      },
      {
        "key": "learning_rate",
        "type": "float",
        "default": 0.01,
        "min": 1e-05,
        "max": 0.05,
        "description": "Initial learning rate of the AdamW optimizer (Ultralytics lr0). Mozilla trained the base model at 0.01; a smaller value changes the weights less."
      },
      {
        "key": "patience",
        "type": "int",
        "default": 3,
        "min": 0,
        "max": 10,
        "description": "Epochs without a better validation result before training stops early; 0 never stops early."
      },
      {
        "key": "cos_lr",
        "type": "bool",
        "default": true,
        "description": "Decay the learning rate along a cosine curve over the run instead of linearly."
      },
      {
        "key": "flipud",
        "type": "float",
        "default": 0.5,
        "min": 0.0,
        "max": 1.0,
        "description": "Probability of a vertical flip of a training image. Pools seen from above have no up; 0 turns it off."
      },
      {
        "key": "scale",
        "type": "float",
        "default": 0.0,
        "min": 0.0,
        "max": 0.5,
        "description": "Random scale augmentation gain (0.2 is up to 20 % larger or smaller). Off by default, as in the base model's training; the model is trained at one ground resolution, so keep it small."
      },
      {
        "key": "translate",
        "type": "float",
        "default": 0.0,
        "min": 0.0,
        "max": 0.3,
        "description": "Random shift of a training image, as a fraction of its size. Off by default, as in the base model's training."
      },
      {
        "key": "val_ratio",
        "type": "float",
        "default": 0.2,
        "min": 0.1,
        "max": 0.4,
        "description": "Share of the chips held out as spatial validation: enough to score on, and enough left to train on."
      },
      {
        "key": "split_seed",
        "type": "int",
        "default": 42,
        "min": 0,
        "max": 2147483647,
        "description": "Seed for the block order of the spatial split."
      },
      {
        "key": "block_size",
        "type": "int",
        "default": 4,
        "min": 1,
        "max": 16,
        "description": "Side of a spatial block, in tile units. At zoom 18 a tile is about 150 m, so 4 keeps neighbouring chips together within about 600 m."
      },
      {
        "key": "freeze_encoder",
        "type": "bool",
        "default": true,
        "description": "Freeze the first 10 layers (the YOLO11 backbone) and train the neck and head only, so the backbone keeps what it learned. Mozilla trained all layers; this default is the one difference."
      },
      {
        "key": "confidence_threshold",
        "type": "float",
        "default": 0.4,
        "min": 0.05,
        "max": 0.95,
        "description": "Minimum pool score to keep a predicted box at inference. Lower finds more pools and more false ones."
      },
      {
        "key": "nms_threshold",
        "type": "float",
        "default": 0.45,
        "min": 0.1,
        "max": 0.9,
        "description": "IoU above which a lower-scoring overlapping box is suppressed at inference."
      }
    ]
