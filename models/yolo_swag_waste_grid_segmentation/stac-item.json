        "classification:classes": [
          {
            "name": "background",
            "value": 0,
            "description": "Grid cell selected from label=0 features, or randomly sampled from cells with zero waste overlap when no label=0 features are provided"
          },
          {
            "name": "waste",
            "value": 1,
            "description": "Grid cell is covered by label=1 features above waste_overlap_threshold"
          }
